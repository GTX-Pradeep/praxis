# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it is ignored by git.

# PostgreSQL (with pgvector) — matches docker-compose.yml defaults
DATABASE_URL=postgres://praxis_app:change_me_app@localhost:5432/praxis

# Owner/admin connection, used only by `npm run db:setup` to create tables
DATABASE_ADMIN_URL=postgres://praxis_owner:change_me_owner@localhost:5432/praxis

# MongoDB — matches docker-compose.yml defaults
MONGODB_URI=mongodb://praxis:change_me_mongo@localhost:27017/?authSource=admin
MONGODB_DB=praxis

# Secret used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_string

# First admin account, created by `npm run db:seed` (password is stored hashed)
SEED_ADMIN_EMAIL=admin@praxis.local
SEED_ADMIN_PASSWORD=choose_a_strong_password

# GitHub personal access token (no scopes needed, public data only).
# Raises the API limit from 60 to 5,000 requests per hour.
GITHUB_TOKEN=
